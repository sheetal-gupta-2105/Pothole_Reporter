# Pothole Reporter Backend Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Model Configuration
# You can specify a Hugging Face repo (e.g. Samdutse/pothole-yolov8) or a local path to .pt weights
MODEL_REPO_OR_PATH=Samdutse/pothole-yolov8
MODEL_FILENAME=best.pt
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_SIZE_MB=10

# Supabase Foundation (Backend Secret / Service Role Key)
# Found in: Supabase Dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key
