# Pothole Reporter Frontend Configuration

# Supabase Foundation (Frontend Publishable / Anonymous Key)
# Found in: Supabase Dashboard -> Project Settings -> API Keys
# CRITICAL SECURITY NOTE:
# Use ONLY the public publishable (anon) key here.
# NEVER place the Supabase secret / service_role key in this file or any frontend code!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
